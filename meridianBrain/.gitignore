# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env

# Per-developer CRM org configuration (use crm-orgs.example.json as template)
platforms/crm/config/crm-orgs.json

# AI workflow artifacts (Meridian runtime data)
core/.ai-artifacts/

# Generated CSV reports
reports/*.csv
core/scripts/workflow/reports/*.csv

# CLI build output (generated by npm run build)
core/scripts/workflow/dist/

# Package lock files (regenerated on npm install)
core/scripts/workflow/package-lock.json

# Editor/IDE directories
.cursor/
.obsidian/
.vscode/
.claude/settings.local.json
terminal-cwd.txt

# Temp working files
.temp/
temp-*
ac-manual.html
analyze-*.ps1
generate-*.js
test-blocks.js
verify-*.html
temp-apply-*.ps1
temp-apply-*.py
temp-check-*.ps1
temp-fetch-*.ps1
temp-update-*.ps1
temp-scaffold-*.json

# Python Salesforce Functions
**/__pycache__/
**/.venv/
**/venv/

# Local Meridian overrides (optional)
core/config/local.json
