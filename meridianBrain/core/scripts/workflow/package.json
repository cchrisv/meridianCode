{
  "name": "@ai-config/scripts",
  "version": "2.0.0",
  "description": "TypeScript-based AI workflow tools for Azure DevOps and Salesforce",
  "keywords": [
    "automation",
    "azure-devops",
    "cli",
    "salesforce",
    "workflow"
  ],
  "bin": {
    "ado-tools": "./dist/cli/ado-tools.js",
    "contact-center-tools": "./dist/cli/contact-center-tools.js",
    "crm-tools": "./dist/cli/crm-tools.js",
    "integration-tools": "./dist/cli/integration-tools.js",
    "knowledge-tools": "./dist/cli/knowledge-tools.js",
    "marketing-automation-tools": "./dist/cli/marketing-automation-tools.js",
    "portal-tools": "./dist/cli/portal-tools.js",
    "pr-tools": "./dist/cli/pr-tools.js",
    "report-tools": "./dist/cli/report-tools.js",
    "team-tools": "./dist/cli/team-tools.js",
    "template-tools": "./dist/cli/template-tools.js",
    "wiki-engine-tools": "./dist/cli/wiki-engine-tools.js",
    "wiki-tools": "./dist/cli/wiki-tools.js",
    "workflow-tools": "./dist/cli/workflow-tools.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src cli --ext .ts",
    "lint:fix": "eslint src cli --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@salesforce/core": "^8.23.0",
    "azure-devops-node-api": "^15.1.2",
    "chroma-js": "^3.2.0",
    "commander": "^12.0.0",
    "diff": "^8.0.3",
    "jsforce": "^3.8.1",
    "juice": "^11.1.1",
    "nunjucks": "^3.2.4",
    "sanitize-html": "^2.17.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/chroma-js": "^3.1.2",
    "@types/diff": "^7.0.2",
    "@types/node": "^20.0.0",
    "@types/nunjucks": "^3.2.6",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
